@page
@model LaMaison.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Reserve a Table";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="text-center mb-5">
                <h1 class="display-5 fw-bold">La Maison</h1>
                <p class="text-muted">Reserve your table and enjoy an unforgettable dining experience.</p>
            </div>

            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <form method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label asp-for="Input.FullName" class="form-label">Full Name</label>
                            <input asp-for="Input.FullName" class="form-control" placeholder="Ivan Horvat" />
                            <span asp-validation-for="Input.FullName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label">Email Address</label>
                            <input asp-for="Input.Email" class="form-control" placeholder="ivan@email.com" />
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.PhoneNumber" class="form-label">Phone Number</label>
                            <input asp-for="Input.PhoneNumber" class="form-control" placeholder="+385911234567" />
                            <span asp-validation-for="Input.PhoneNumber" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.Date" class="form-label">Date</label>
                                <input asp-for="Input.Date" type="date" class="form-control"
                                       min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")"
                                       max="@DateTime.Today.AddDays(30).ToString("yyyy-MM-dd")" />
                                <span asp-validation-for="Input.Date" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.PartySize" class="form-label">Party Size</label>
                                <input asp-for="Input.PartySize" type="number" class="form-control"
                                       id="partySizeInput" min="1" max="10" />
                                <span asp-validation-for="Input.PartySize" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3" id="privateDiningSection" style="display:none;">
                            <div class="form-check">
                                <input asp-for="Input.IsPrivateDining" class="form-check-input" id="privateDiningCheck" />
                                <label asp-for="Input.IsPrivateDining" class="form-check-label">
                                    Private Dining Room
                                    <small class="text-muted d-block">Available Fri &amp; Sat, 18:00–22:00. Groups of 6–12.</small>
                                </label>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.TimeSlot" class="form-label">Time Slot</label>
                            <select asp-for="Input.TimeSlot" class="form-select" id="timeSlotSelect" disabled>
                                <option value="">— select date and party size first —</option>
                            </select>
                            <span asp-validation-for="Input.TimeSlot" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Input.SpecialRequests" class="form-label">
                                Special Requests <span class="text-muted small">(optional)</span>
                            </label>
                            <textarea asp-for="Input.SpecialRequests" class="form-control" rows="3"
                                      maxlength="500" placeholder="Allergies, celebrations, seating preferences..."></textarea>
                            <div class="d-flex justify-content-end">
                                <small class="text-muted" id="charCount">0 / 500</small>
                            </div>
                            <span asp-validation-for="Input.SpecialRequests" class="text-danger small"></span>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-dark btn-lg">Reserve Table</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/reservation.js"></script>
}
