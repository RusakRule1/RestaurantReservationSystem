@page "/admin/details/{id:int}"
@model LaMaison.Web.Pages.Admin.DetailsModel
@{
    ViewData["Title"] = $"Reservation {Model.Reservation.ReferenceCode}";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <a asp-page="Index" class="btn btn-outline-secondary btn-sm">← Back to List</a>
                <span class="badge @GetStatusBadgeClass(Model.Reservation.Status) fs-6">
                    @Model.Reservation.Status
                </span>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">@Model.Reservation.ReferenceCode</h5>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-6">
                            <small class="text-muted">Guest Name</small>
                            <div class="fw-semibold">@Model.Reservation.FullName</div>
                        </div>
                        <div class="col-6">
                            <small class="text-muted">Email</small>
                            <div class="fw-semibold">@Model.Reservation.Email</div>
                        </div>
                        <div class="col-6">
                            <small class="text-muted">Phone</small>
                            <div class="fw-semibold">@Model.Reservation.PhoneNumber</div>
                        </div>
                        <div class="col-6">
                            <small class="text-muted">Party Size</small>
                            <div class="fw-semibold">@Model.Reservation.PartySize guest@(Model.Reservation.PartySize > 1 ? "s" : "")</div>
                        </div>
                        <div class="col-6">
                            <small class="text-muted">Date</small>
                            <div class="fw-semibold">@Model.Reservation.Date.ToString("dddd, MMMM d, yyyy")</div>
                        </div>
                        <div class="col-6">
                            <small class="text-muted">Time</small>
                            <div class="fw-semibold">@Model.Reservation.TimeSlot.ToString("HH:mm")</div>
                        </div>
                        <div class="col-6">
                            <small class="text-muted">Type</small>
                            <div class="fw-semibold">@(Model.Reservation.IsPrivateDining ? "Private Dining" : "Regular Dining")</div>
                        </div>
                        <div class="col-6">
                            <small class="text-muted">Status</small>
                            <div class="fw-semibold">@Model.Reservation.Status</div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.Reservation.SpecialRequests))
                        {
                            <div class="col-12">
                                <small class="text-muted">Special Requests</small>
                                <div class="fw-semibold">@Model.Reservation.SpecialRequests</div>
                            </div>
                        }

                        <div class="col-12 border-top pt-3 mt-2">
                            <small class="text-muted">Created</small>
                            <div class="fw-semibold">@Model.Reservation.CreatedAt.ToString("dd MMM yyyy HH:mm") UTC</div>
                        </div>
                        <div class="col-12">
                            <small class="text-muted">Last Updated</small>
                            <div class="fw-semibold">@Model.Reservation.UpdatedAt.ToString("dd MMM yyyy HH:mm") UTC</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header">
                    <h6 class="mb-0">Update Status</h6>
                </div>
                <div class="card-body">
                    <form method="post" asp-page-handler="UpdateStatus" asp-route-id="@Model.Reservation.Id">
                        @Html.AntiForgeryToken()
                        <div class="d-flex gap-2 flex-wrap">
                            @foreach (var status in Enum.GetValues<LaMaison.Core.Enums.ReservationStatus>())
                            {
                                <button type="submit"
                                        name="NewStatus"
                                        value="@status"
                                        class="btn @(Model.Reservation.Status == status ? GetStatusBtnClass(status) : "btn-outline-secondary")">
                                    @status
                                </button>
                            }
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@functions {
    string GetStatusBadgeClass(LaMaison.Core.Enums.ReservationStatus status) => status switch
    {
        LaMaison.Core.Enums.ReservationStatus.Confirmed => "bg-success",
        LaMaison.Core.Enums.ReservationStatus.Cancelled => "bg-danger",
        LaMaison.Core.Enums.ReservationStatus.Completed => "bg-primary",
        _ => "bg-warning text-dark"
    };

    string GetStatusBtnClass(LaMaison.Core.Enums.ReservationStatus status) => status switch
    {
        LaMaison.Core.Enums.ReservationStatus.Confirmed => "btn-success",
        LaMaison.Core.Enums.ReservationStatus.Cancelled => "btn-danger",
        LaMaison.Core.Enums.ReservationStatus.Completed => "btn-primary",
        _ => "btn-warning"
    };
}
