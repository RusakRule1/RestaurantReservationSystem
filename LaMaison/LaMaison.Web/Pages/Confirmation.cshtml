@page
@model LaMaison.Web.Pages.ConfirmationModel
@{
    ViewData["Title"] = "Reservation Confirmed";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 text-center">

            <div class="mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="#2d6a4f" class="bi bi-check-circle-fill" viewBox="0 0 16 16">
                    <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z" />
                </svg>
            </div>

            <h1 class="display-6 fw-bold mb-2">Reservation Confirmed!</h1>
            <p class="text-muted mb-4">Thank you for choosing La Maison. We look forward to welcoming you.</p>

            <div class="card shadow-sm mb-4">
                <div class="card-body p-4">

                    <div class="mb-3">
                        <small class="text-muted text-uppercase tracking-wide">Reference Code</small>
                        <div class="fs-4 fw-bold text-dark">@Model.Reservation.ReferenceCode</div>
                    </div>

                    <hr />

                    <div class="row text-start g-3">
                        <div class="col-6">
                            <small class="text-muted">Guest</small>
                            <div class="fw-semibold">@Model.Reservation.FullName</div>
                        </div>
                        <div class="col-6">
                            <small class="text-muted">Email</small>
                            <div class="fw-semibold">@Model.Reservation.Email</div>
                        </div>
                        <div class="col-6">
                            <small class="text-muted">Date</small>
                            <div class="fw-semibold">@Model.Reservation.Date.ToString("dddd, MMMM d, yyyy")</div>
                        </div>
                        <div class="col-6">
                            <small class="text-muted">Time</small>
                            <div class="fw-semibold">@Model.Reservation.TimeSlot.ToString("HH:mm")</div>
                        </div>
                        <div class="col-6">
                            <small class="text-muted">Party Size</small>
                            <div class="fw-semibold">@Model.Reservation.PartySize guest@(Model.Reservation.PartySize > 1 ? "s" : "")</div>
                        </div>
                        <div class="col-6">
                            <small class="text-muted">Type</small>
                            <div class="fw-semibold">@(Model.Reservation.IsPrivateDining ? "Private Dining" : "Regular Dining")</div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.Reservation.SpecialRequests))
                        {
                            <div class="col-12">
                                <small class="text-muted">Special Requests</small>
                                <div class="fw-semibold">@Model.Reservation.SpecialRequests</div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <a asp-page="Index" class="btn btn-outline-dark">Make Another Reservation</a>
        </div>
    </div>
</div>
